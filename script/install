#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname $0)"/..

# skip the installers that ship inside the vendored oh-my-zsh checkout, and
# mise, which `dot` runs on its own before this
find . -name install.sh -not -path './.oh-my-zsh/*' -not -path './mise/*' | sort | while read installer
do
  echo "› ${installer}"
  sh "${installer}"
done
